# Database Configuration
# Connection string for MongoDB Atlas
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
# Get this from MongoDB Atlas cluster connection string
DATABASE_URL=mongodb+srv://user:password@cluster.mongodb.net/lunar?retryWrites=true&w=majority

# NextAuth.js Configuration
# Secret key for encrypting sessions (minimum 32 characters)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_secret_key_here_minimum_32_characters

# Application URL for authentication redirects
# In development: http://localhost:3000
# In production: https://your-domain.com
NEXTAUTH_URL=http://localhost:3000

# Google OAuth Configuration
# Get credentials from: https://console.cloud.google.com
# Set authorized redirect URI to: NEXTAUTH_URL/api/auth/callback/google
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here

# Pusher Real-time Messaging Configuration
# Get credentials from: https://pusher.com/
# Public key (safe to expose in frontend)
NEXT_PUBLIC_PUSHER_KEY=your_pusher_key
# Cluster where your Pusher app is hosted
NEXT_PUBLIC_PUSHER_CLUSTER=eu

# Private Pusher credentials (server-side only)
PUSHER_APP_ID=your_pusher_app_id
PUSHER_KEY=your_pusher_key
PUSHER_SECRET=your_pusher_secret

# Location Services Configuration
# OpenCage Geocoding API key (reverse geocoding and location lookup)
# Get from: https://opencagedata.com/
OPENCAGE_API_KEY=your_opencage_api_key

# OpenRoute Service API key (travel time and routing calculations)
# Get from: https://openrouteservice.org/
OPENROUTE_API_KEY=your_openroute_api_key

# Email Service Configuration (Maileroo)
# API endpoint for email delivery
MAILEROO_API_BASE_URL=https://smtp.maileroo.com/api/v2

# API key for Maileroo email service
# Get from: https://maileroo.com/
MAILEROO_API_KEY=your_maileroo_api_key

# Sender email address for outgoing emails
MAILEROO_FROM_EMAIL=noreply@lunar.app

# Optional: Development/Debug Settings
# Uncomment for verbose logging during development
# DEBUG=lunar:*
