generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

//////////////////////////
// USER
//////////////////////////

model User {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  email        String  @unique
  username     String  @unique
  passwordHash String?

  fname String?
  lname String?

  bio String?
  pfp String?

  role Role @default(BASIC)

  isBanned   Boolean   @default(false)
  banExpires DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //////////////////////
  // RELATIONS
  //////////////////////

  accounts       Account[]
  tasks          Task[]
  exams          Exam[]
  events         Event[]
  notifications  Notification[]
  preferences    UserPreferences?

  progress       UserProgress?

  sentRequests     FriendRequest[] @relation("sender")
  receivedRequests FriendRequest[] @relation("receiver")

  reportsMade     Report[] @relation("UserReportsMade")
  reportsReceived Report[] @relation("UserReportsReceived")

  handledReports Report[] @relation("ModeratorHandledReports")

  appeals        Appeal[]
  handledAppeals Appeal[] @relation("ModeratorHandledAppeals")
}

enum Role {
  BASIC
  SUPERUSER
}

//////////////////////////
// AUTH ACCOUNTS
//////////////////////////

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId

  type              String
  provider          String
  providerAccountId String

  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

//////////////////////////
// GAMIFICATION
//////////////////////////

model UserProgress {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @unique @db.ObjectId

  points     Int @default(0)
  level      Int @default(1)
  experience Int @default(0)

  streak Int @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions PointTransaction[]
}

model PointTransaction {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  progressId String @db.ObjectId
  progress   UserProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)

  amount Int
  reason String

  taskId String? @db.ObjectId

  createdAt DateTime @default(now())
}

//////////////////////////
// TASKS
//////////////////////////

model Task {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  title       String
  description String?

  dueDate DateTime?

  completed   Boolean  @default(false)
  completedAt DateTime?

  status   String  @default("todo")
  priority String  @default("Low")

  duration Int @default(0)

  subtasks String[] @default([])

  url String?

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  examId String? @db.ObjectId
  exam   Exam?   @relation(fields: [examId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////
// EXAMS / REVISION
//////////////////////////

model Exam {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title    String
  examDate DateTime

  maxTimePerDay   Int
  unavailableDays DateTime[]

  tasks             Task[]
  revisionMaterials RevisionMaterial[]

  createdAt DateTime @default(now())
}

model RevisionMaterial {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  examId String @db.ObjectId
  exam   Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)

  title    String
  type     String
  duration Int
  url      String?
}

//////////////////////////
// EVENTS / CALENDAR
//////////////////////////

model Event {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String?

  start  DateTime
  end    DateTime
  allDay Boolean @default(false)

  category String

  startCoords       Json?
  destinationCoords Json?

  travelDuration Int?

  startLocationName String?
  destLocationName  String?

  transportMode String?

  recurrence Json?
  exceptions String[] @default([])

  googleEventId String?
  lastSyncedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////
// SOCIAL
//////////////////////////

model FriendRequest {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  senderId String @db.ObjectId
  sender   User   @relation("sender", fields: [senderId], references: [id], onDelete: Cascade)

  receiverId String @db.ObjectId
  receiver   User   @relation("receiver", fields: [receiverId], references: [id], onDelete: Cascade)

  status FriendStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([senderId, receiverId])
}

enum FriendStatus {
  PENDING
  ACCEPTED
  REJECTED
}

//////////////////////////
// NOTIFICATIONS
//////////////////////////

model Notification {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  title   String
  message String

  type NotificationType

  isRead Boolean @default(false)

  link String?

  createdAt DateTime @default(now())
  expiresAt DateTime?

  @@index([userId, isRead])
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

//////////////////////////
// USER PREFERENCES
//////////////////////////

model UserPreferences {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId String @unique @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  workStartTime String
  workEndTime   String

  daysOff String[]

  sessionLength Int
  breakLength   Int
  breaksPerDay  Int

  taskOrder String

  maxTasksPerDay      Int
  defaultTaskDuration Int

  reminderDays Int
}

//////////////////////////
// REPORT SYSTEM
//////////////////////////

model Report {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  reportedUserId String @db.ObjectId
  reportedUser   User   @relation("UserReportsReceived", fields: [reportedUserId], references: [id])

  reportedById String @db.ObjectId
  reportedBy   User   @relation("UserReportsMade", fields: [reportedById], references: [id])

  reason      String
  description String?

  status ReportStatus @default(PENDING)

  handledById String? @db.ObjectId
  handledBy   User?   @relation("ModeratorHandledReports", fields: [handledById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appeals Appeal[]
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

model Appeal {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId   String @db.ObjectId
  reportId String @db.ObjectId

  description String

  status AppealStatus @default(PENDING)

  user   User   @relation(fields: [userId], references: [id])
  report Report @relation(fields: [reportId], references: [id])

  handledById String? @db.ObjectId
  handledBy   User?   @relation("ModeratorHandledAppeals", fields: [handledById], references: [id])

  createdAt DateTime @default(now())
}

enum AppealStatus {
  PENDING
  APPROVED
  REJECTED
}