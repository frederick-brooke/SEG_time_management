generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

//////////////////////////
// USER
//////////////////////////

model User {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  email        String  @unique
  username     String  @unique
  passwordHash String?

  fname String?
  lname String?

  bio String?
  pfp String?

  role Role @default(BASIC)

  isBanned   Boolean   @default(false)
  banExpires DateTime?
  accounts      Account[]
  tasks         Task[]
  preferences   UserPreferences?
  events        Event[]
  exams         Exam[]
  notifications Notification[]

  sentRequests     FriendRequest[] @relation("sender")
  receivedRequests FriendRequest[] @relation("receiver")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //////////////////////
  // RELATIONS
  //////////////////////

  accounts       Account[]
  tasks          Task[]
  exams          Exam[]
  events         Event[]
  notifications  Notification[]
  preferences    UserPreferences?

  progress       UserProgress?
  inventory UserInventory[]

  sentRequests     FriendRequest[] @relation("sender")
  receivedRequests FriendRequest[] @relation("receiver")

  reportsMade     Report[] @relation("UserReportsMade")
  reportsReceived Report[] @relation("UserReportsReceived")

  handledReports Report[] @relation("ModeratorHandledReports")

  isBanned   Boolean   @default(false)
  banExpires DateTime?

  appeals        Appeal[]
  handledAppeals Appeal[] @relation("ModeratorHandledAppeals")

  conversations ConversationParticipant[]
  sentMessages  Message[]

  createdModules Module[]       @relation("ModuleCreator")
  moduleMembers  ModuleMember[]
}

enum Role {
  BASIC
  SUPERUSER
}

//////////////////////////
// AUTH ACCOUNTS
//////////////////////////

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId

  type              String
  provider          String
  providerAccountId String

  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

//////////////////////////
// GAMIFICATION
//////////////////////////

model UserProgress {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @unique @db.ObjectId

  points     Int @default(0)
  level      Int @default(1)
  experience Int @default(0)

  streak Int @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions PointTransaction[]
  equippedTitle  String?

  equippedFrame  String?
  xpBoostExpires DateTime?
  streakShields  Int       @default(0)
  shieldUsedDate DateTime?

inventory UserInventory[]
}

model PointTransaction {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  progressId String @db.ObjectId
  progress   UserProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)

  amount Int
  reason String

  taskId String? @db.ObjectId

  createdAt DateTime @default(now())
}

//////////////////////////
// TASKS
//////////////////////////

model Task {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  title       String
  description String?

  dueDate DateTime?

  completed   Boolean  @default(false)
  completedAt DateTime?

  status   String  @default("todo")
  priority String  @default("Low")

  duration Int @default(0)

  subtasks String[] @default([])

  url String?

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  examId String? @db.ObjectId
  exam   Exam?   @relation(fields: [examId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////
// EXAMS / REVISION
//////////////////////////

model Exam {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title    String
  examDate DateTime

  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  description   String?
  dueDate       DateTime?
  completed     Boolean   @default(false)
  completedAt   DateTime?
  status        String    @default("todo")
  duration      Int       @default(0)
  durationHours String?
  durationMins  String?
  subtasks      String[]  @default([])
  priority      String    @default("Low")
  url           String?

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  examId String? @db.ObjectId
  exam   Exam?   @relation(fields: [examId], references: [id])

  moduleId     String? @db.ObjectId
  module       Module? @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  isModuleTask Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

model Notification {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  userId    String           @db.ObjectId
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())
  expiresAt DateTime?

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([createdAt])
}

model UserPreferences {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  userId              String   @unique @db.ObjectId
  user                User     @relation(fields: [userId], references: [id])
  workStartTime       String
  workEndTime         String
  daysOff             String[]
  sessionLength       Int
  breakLength         Int
  breaksPerDay        Int
  taskOrder           String
  maxTasksPerDay      Int
  defaultTaskDuration Int
  reminderDays        Int
}

model Exam {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title           String
  examDate        DateTime
  maxTimePerDay   Int
  unavailableDays DateTime[]

  tasks             Task[]
  revisionMaterials RevisionMaterial[]

  createdAt DateTime @default(now())
}

model RevisionMaterial {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  examId String @db.ObjectId
  exam   Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)

  title    String
  type     String
  duration Int
  url      String?
}

//////////////////////////
// EVENTS / CALENDAR
//////////////////////////

model Event {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String?

  start  DateTime
  end    DateTime
  allDay Boolean @default(false)

  category String

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String?
  start       DateTime
  end         DateTime
  allDay      Boolean  @default(false)
  category    String

  startCoords       Json?
  destinationCoords Json?

  travelDuration Int?

  startLocationName String?
  destLocationName  String?

  transportMode String?

  recurrence Json?
  exceptions String[] @default([])

  googleEventId String?
  lastSyncedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////
// SOCIAL
//////////////////////////

model FriendRequest {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  senderId String @db.ObjectId
  sender   User   @relation("sender", fields: [senderId], references: [id], onDelete: Cascade)

  receiverId String @db.ObjectId
  receiver   User   @relation("receiver", fields: [receiverId], references: [id], onDelete: Cascade)

  status FriendStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([senderId, receiverId])
}

enum FriendStatus {
  PENDING
  ACCEPTED
  REJECTED
}

//////////////////////////
// NOTIFICATIONS
//////////////////////////

model Notification {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  title   String
  message String

  type NotificationType

  isRead Boolean @default(false)

  link String?

  createdAt DateTime @default(now())
  expiresAt DateTime?

  @@index([userId, isRead])
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

//////////////////////////
// USER PREFERENCES
//////////////////////////

model UserPreferences {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId String @unique @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  workStartTime String
  workEndTime   String

  daysOff String[]

  sessionLength Int
  breakLength   Int
  breaksPerDay  Int

  taskOrder String

  maxTasksPerDay      Int
  defaultTaskDuration Int

  reminderDays Int
}

//////////////////////////
// REPORT SYSTEM
//////////////////////////

  recurrence Json?
  exceptions String[] @default([])

  googleEventId String?
  lastSyncedAt  DateTime?

  moduleId      String? @db.ObjectId
  module        Module? @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  isModuleEvent Boolean @default(false) // Flag for quick filtering

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Report {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  reportedUserId String @db.ObjectId
  reportedUser   User   @relation("UserReportsReceived", fields: [reportedUserId], references: [id])

  reportedById String @db.ObjectId
  reportedBy   User   @relation("UserReportsMade", fields: [reportedById], references: [id])

  reason      String
  description String?

  status ReportStatus @default(PENDING)

  handledById String? @db.ObjectId
  handledBy   User?   @relation("ModeratorHandledReports", fields: [handledById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appeals Appeal[]
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

model Appeal {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId   String @db.ObjectId
  reportId String @db.ObjectId

  description String

  status AppealStatus @default(PENDING)
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  userId      String       @db.ObjectId
  reportId    String       @db.ObjectId
  description String
  createdAt   DateTime     @default(now())
  status      AppealStatus @default(PENDING)

  user   User   @relation(fields: [userId], references: [id])
  report Report @relation(fields: [reportId], references: [id])

  handledById String? @db.ObjectId
  handledBy   User?   @relation("ModeratorHandledAppeals", fields: [handledById], references: [id])

  createdAt DateTime @default(now())
}

enum AppealStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ShopItemType {
  TITLE
  FRAME
  FUNCTIONAL
}

model ShopItem {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  name        String       @unique
  description String
  type        ShopItemType
  price       Int
  value       String
  icon        String
  rarity      String       @default("common")
  isActive    Boolean      @default(true)

  inventory UserInventory[]
}

model UserInventory {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  itemId      String   @db.ObjectId
  progressId  String   @db.ObjectId
  purchasedAt DateTime @default(now())

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  item     ShopItem     @relation(fields: [itemId], references: [id])
  progress UserProgress @relation(fields: [progressId], references: [id])

  @@unique([userId, itemId])
}
model Conversation {
  id            String                    @id @default(auto()) @map("_id") @db.ObjectId
  participants  ConversationParticipant[]
  messages      Message[]
  lastMessage   String?
  lastMessageAt DateTime?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  isGroup     Boolean @default(false)
  name        String?
  createdById String? @db.ObjectId
}

model ConversationParticipant {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String       @db.ObjectId
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String       @db.ObjectId
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member") // "admin" | "member"
  joinedAt       DateTime     @default(now())
  deletedAt      DateTime?

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String       @db.ObjectId
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String       @db.ObjectId
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  createdAt      DateTime     @default(now())
}

model Module {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  maxMembers  Int     @default(50) // Max users allowed
  joinPin     String  @unique // 6-character unique code

  creatorId String @db.ObjectId
  creator   User   @relation("ModuleCreator", fields: [creatorId], references: [id])

  members ModuleMember[]
  events  Event[]
  tasks   Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ModuleMember {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  moduleId String @db.ObjectId
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role ModuleRole @default(MEMBER)

  joinedAt DateTime @default(now())

  @@unique([moduleId, userId]) // User can only join each module once
}

enum ModuleRole {
  OWNER // Creator (full control)
  ADMIN // Can manage members
  MEMBER // Regular participant
}
