generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "mongodb"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

enum Role {
  BASIC
  SUPERUSER
}

enum FriendStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum AppealStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ShopItemType {
  TITLE
  FRAME
  FUNCTIONAL
}

enum ModuleRole {
  OWNER
  ADMIN
  MEMBER
}

enum GroupRole {
  OWNER
  MEMBER
}

model User {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  email        String  @unique
  username     String  @unique
  passwordHash String?
  fname        String?
  lname        String?
  bio          String?
  pfp          String?

  // Location fields for friends map
  city     String?
  country  String?
  location Json? // { lat: number, lng: number }

  role       Role    @default(BASIC)
  isBanned   Boolean @default(false)
  banExpires DateTime?

  accounts      Account[]
  tasks         Task[]
  exams         Exam[]
  events        Event[]
  notifications Notification[]
  preferences   UserPreferences?

  progress  UserProgress?
  inventory UserInventory[]

  sentRequests     FriendRequest[] @relation("sender")
  receivedRequests FriendRequest[] @relation("receiver")

  reportsMade     Report[] @relation("UserReportsMade")
  reportsReceived Report[] @relation("UserReportsReceived")
  handledReports  Report[] @relation("ModeratorHandledReports")

  appeals        Appeal[]
  handledAppeals Appeal[] @relation("ModeratorHandledAppeals")

  conversations   ConversationParticipant[]
  sentMessages    Message[]
  createdModules  Module[]       @relation("ModuleCreator")
  moduleMembers   ModuleMember[]

  createdGroups Group[]       @relation("GroupCreator")
  groupMembers  GroupMember[]
 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                       String  @id @default(auto()) @map("_id") @db.ObjectId
  userId                   String  @db.ObjectId
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? @db.String
  access_token             String? @db.String
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? @db.String
  session_state            String?
  refresh_token_expires_in Int?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model UserProgress {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  userId         String    @unique @db.ObjectId
  points         Int       @default(0)
  level          Int       @default(1)
  experience     Int       @default(0)
  streak         Int       @default(0)
  equippedTitle  String?
  equippedFrame  String?
  xpBoostExpires DateTime?
  streakShields  Int       @default(0)
  shieldUsedDate DateTime?
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions PointTransaction[]
  inventory    UserInventory[]
}

model PointTransaction {
  id         String       @id @default(auto()) @map("_id") @db.ObjectId
  progressId String       @db.ObjectId
  progress   UserProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)
  amount     Int
  reason     String
  taskId     String?  @db.ObjectId
  createdAt  DateTime @default(now())
}

model ShopItem {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  name        String       @unique
  description String
  type        ShopItemType
  price       Int
  value       String
  icon        String
  rarity      String       @default("common")
  isActive    Boolean      @default(true)
  inventory UserInventory[]
}

model UserInventory {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  itemId      String   @db.ObjectId
  progressId  String   @db.ObjectId
  purchasedAt DateTime @default(now())
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  item     ShopItem     @relation(fields: [itemId], references: [id])
  progress UserProgress @relation(fields: [progressId], references: [id])
  @@unique([userId, itemId])
}

model Task {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  dueDate     DateTime?
  completed   Boolean   @default(false)
  completedAt DateTime?
  status      String    @default("todo")
  priority    String    @default("Low")
  duration    Int       @default(0)
  subtasks    String[]  @default([])
  url         String?
  userId       String  @db.ObjectId
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  examId       String? @db.ObjectId
  exam         Exam?   @relation(fields: [examId], references: [id])
  
  moduleId     String? @db.ObjectId
  module       Module? @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  isModuleTask Boolean @default(false)
  moduleTaskGroupId String? @db.ObjectId

  groupTaskGroupId  String?  @db.ObjectId
  groupId           String?  @db.ObjectId
  group             Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  isGroupTask       Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Exam {
  id              String     @id @default(auto()) @map("_id") @db.ObjectId
  userId          String     @db.ObjectId
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  examDate        DateTime
  maxTimePerDay   Int
  unavailableDays DateTime[]
  tasks             Task[]
  revisionMaterials RevisionMaterial[]
  createdAt DateTime @default(now())
}

model RevisionMaterial {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  examId   String @db.ObjectId
  exam     Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)
  title    String
  type     String
  duration Int
  url      String?
}

model Event {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  userId            String    @db.ObjectId
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  start             DateTime
  end               DateTime
  allDay            Boolean   @default(false)
  category          String
  startCoords       Json?
  destinationCoords Json?
  travelDuration    Int?
  startLocationName String?
  destLocationName  String?
  transportMode     String?
  recurrence        Json?
  exceptions        String[]  @default([])
  googleEventId     String?
  lastSyncedAt      DateTime?

  moduleId          String?   @db.ObjectId
  module            Module?   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  isModuleEvent     Boolean   @default(false)
  moduleEventGroupId String? @db.ObjectId

  groupEventGroupId String?  @db.ObjectId
  groupId           String?  @db.ObjectId
  group             Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  isGroupEvent      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FriendRequest {
  id         String       @id @default(auto()) @map("_id") @db.ObjectId
  senderId   String       @db.ObjectId
  sender     User         @relation("sender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String       @db.ObjectId
  receiver   User         @relation("receiver", fields: [receiverId], references: [id], onDelete: Cascade)
  status     FriendStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  @@unique([senderId, receiverId])
}

model Notification {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  userId    String           @db.ObjectId
  user      User             @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())
  expiresAt DateTime?
  @@index([userId, isRead])
  @@index([createdAt])
}

model UserPreferences {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  userId              String   @unique @db.ObjectId
  user                User     @relation(fields: [userId], references: [id])
  workStartTime       String
  workEndTime         String
  daysOff             String[]
  sessionLength       Int
  breakLength         Int
  breaksPerDay        Int
  taskOrder           String
  maxTasksPerDay      Int
  defaultTaskDuration Int
  reminderDays        Int
}

model Report {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  reportedUserId String       @db.ObjectId
  reportedUser   User         @relation("UserReportsReceived", fields: [reportedUserId], references: [id])
  reportedById   String       @db.ObjectId
  reportedBy     User         @relation("UserReportsMade", fields: [reportedById], references: [id])
  reason         String
  description    String?
  status         ReportStatus @default(PENDING)
  handledById    String?      @db.ObjectId
  handledBy      User?        @relation("ModeratorHandledReports", fields: [handledById], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  appeals Appeal[]
}

model Appeal {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  userId      String       @db.ObjectId
  reportId    String       @db.ObjectId
  description String
  status      AppealStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id])
  report      Report       @relation(fields: [reportId], references: [id])
  handledById String?      @db.ObjectId
  handledBy   User?        @relation("ModeratorHandledAppeals", fields: [handledById], references: [id])
}

model Conversation {
  id            String                    @id @default(auto()) @map("_id") @db.ObjectId
  participants  ConversationParticipant[]
  messages      Message[]
  lastMessage   String?
  lastMessageAt DateTime?
  isGroup       Boolean                   @default(false)
  name          String?
  createdById   String?                   @db.ObjectId
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
}

model ConversationParticipant {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String       @db.ObjectId
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String       @db.ObjectId
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  joinedAt       DateTime     @default(now())
  deletedAt      DateTime?
  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String       @db.ObjectId
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String       @db.ObjectId
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  createdAt      DateTime     @default(now())
}

model Module {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  maxMembers  Int     @default(50)
  joinPin     String  @unique
  creatorId   String  @db.ObjectId
  creator     User    @relation("ModuleCreator", fields: [creatorId], references: [id])
  members ModuleMember[]
  events  Event[]
  tasks   Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ModuleMember {
  id       String     @id @default(auto()) @map("_id") @db.ObjectId
  moduleId String     @db.ObjectId
  module   Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  userId   String     @db.ObjectId
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     ModuleRole @default(MEMBER)
  joinedAt DateTime   @default(now())
  @@unique([moduleId, userId])
}

model Group {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  creatorId   String  @db.ObjectId
  creator     User    @relation("GroupCreator", fields: [creatorId], references: [id])
  members     GroupMember[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  events  Event[]
  tasks   Task[]
}

model GroupMember {
  id       String    @id @default(auto()) @map("_id") @db.ObjectId
  groupId  String    @db.ObjectId
  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String    @db.ObjectId
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())
  @@unique([groupId, userId])

}